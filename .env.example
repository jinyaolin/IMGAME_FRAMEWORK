# imgame 環境變數範本 — 複製成 .env(或寫進 systemd drop-in)並填值。真檔含密鑰,勿進 git。
# 生產部署的值多半放 /etc/systemd/system/imgame.service.d/labs.conf 的 Environment=,
# 密鑰(AUTH_COOKIE_SECRET、TURN_SECRET、CF_TURN_API_TOKEN)可放本檔(EnvironmentFile=/root/imgame/.env)。

# ── 子路徑部署(見 docs/architecture.md §9.5)──
BASE_PATH=/labs/game                      # 所有路由/socket.io 掛的前綴;本地開發留空 = 掛在根
PUBLIC_ORIGIN=https://zaistudio.tw        # QR/分享連結的對外網域
LOGIN_URL=https://zaistudio.tw/studio/login
AUTH_COOKIE_SECRET=                       # 與主站共用的 HMAC 密鑰(驗 zai_session cookie);留空 = 關閉登入(本地開發)

# ── P2P 的 ICE/TURN 設定(見 docs/architecture.md §9.6;由 GET /api/ice 提供給前端)──
# STUN 一律有(可覆蓋)。TURN 只在下列有設時加。優先序:Cloudflare > 本機 coturn > 純 STUN。
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302   # 逗號分隔,可覆蓋預設

# 方案 A(推薦):Cloudflare Realtime TURN — 全球 anycast 就近中繼、含 TURN over TLS 443、免費 1TB/月。
# dash.cloudflare.com → Realtime(Calls)→ 建 TURN Key → 取得 Key ID + API Token。設了就優先用。
CF_TURN_KEY_ID=                           # Turn Token ID(32 hex)
CF_TURN_API_TOKEN=                        # 該 key 的 API Token(只顯示一次)— 密鑰,勿外流

# 方案 B(備援/替代):本機 coturn(單點中繼)。/api/ice 在 CF 取用失敗時退回此。
# coturn 設 use-auth-secret + static-auth-secret,伺服器用 TURN_SECRET 產生 REST 短效憑證。
TURN_URLS=                                # 例:turn:zaistudio.tw:3478,turn:zaistudio.tw:3478?transport=tcp
TURN_SECRET=                             # 與 coturn static-auth-secret 同一把;密鑰,勿外流
TURN_TTL=43200                           # 憑證有效秒數(預設 12h)
# 或用靜態長期憑證(較不安全,不建議):TURN_USERNAME / TURN_CREDENTIAL

# ── AI(選配;見 server/ai/ai-config.example.json)──
# Kimi/Moonshot 憑證放 server/ai/ai-config.json,不在本檔。
